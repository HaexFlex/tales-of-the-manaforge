      "graze": "sfx_battle_graze",
      "hit": "sfx_battle_hit",
      "crush": "sfx_battle_crush"
    },
    "crit_layer": {
      "cue": "sfx_battle_crit",
      "same_frame_as_impact": true,
      "at_fast_speed": "skip",
      "at_fast_speed_alt_db": -6.0
    },
    "beast_hurt": {
      "cue": "sfx_battle_beast_hurt",
      "delay_sec": 0.06,
      "beast_targets_only": true,
      "skip_if_pool_full": true
    },
    "jitter": {
      "pitch_min": 0.96,
      "pitch_max": 1.04,
      "gain_db": 1.0,
      "note": "Fixed pitch plus random jitter on every play. Never pitch_scale for 2x/4x. Set volume_db and pitch_scale explicitly."
    },
    "fast_speeds": {
      "speeds": [
        2,
        4
      ],
      "note": "Only while the player picks every action; Strike for me and Auto are 1x only. Drop the crit layer (or -6 dB) and skip beast_hurt when the pool is full."
    },
    "voices": {
      "pool": 4,
      "world_max": 3,
      "keep_free_for": "SFX_UI",
      "when_full": "drop the new World cue; never steal a UI voice"
    },
    "throttle_sec": {
      "sfx_battle_turn": 0.3,
      "sfx_battle_victory": 1.0
    },
    "victory_once_per_room": true,
    "silent_in": [
      "idle",
      "offline",
      "simulate",
      "load",
      "scene_restore",
      "headless"
    ],
    "duck": false,
