{
  "version": 1,
  "notes": [
    "R6 PLACEHOLDER. Proposed new data/combat_anims.json. Not on origin/main.",
    "Live battle poses today are single 128×128 stills (battle_view.gd PARTY_POSES / BEAST_*).",
    "Tick = BattlePlayback GAP_STRIKE_SEC 1.0s; impact / damage float at REACT_SEC 0.4s; hurt ends HURT_END_SEC 0.75s.",
    "Speed button cycles 1×/2×/4×/8× (battle_view.gd). Playback: delta*=speed and _scaled(sec)=sec/speed.",
    "Sprite scheme wpn_<family>_t<tier>. Families from live damage_kind / craft line."
  ],
  "tick": {
    "strike_sec": 1.0,
    "react_sec": 0.4,
    "hurt_end_sec": 0.75,
    "gap_short_sec": 0.6,
    "gap_ko_sec": 0.8,
    "nudge_sec": 0.25,
    "flash_sec": 0.15,
    "cite": {
      "GAP_STRIKE_SEC": "scripts/battle/battle_playback.gd:7",
      "REACT_SEC": "scripts/battle/battle_playback.gd:12",
      "HURT_END_SEC": "scripts/battle/battle_playback.gd:13",
      "speed_cycle": "scripts/battle/battle_view.gd:2312-2320",
      "impact_at": "cues_for_event uses REACT_SEC/speed (battle_playback.gd:476)"
    }
  },
  "speed_scale": {
    "steps": [1, 2, 4, 8],
    "rule": "wall_ms_per_frame = base_ms_per_frame / speed; hit_frame wall time = react_sec / speed",
    "at_4x": {
      "strike_wall_sec": 0.25,
      "react_wall_sec": 0.10,
      "hurt_end_wall_sec": 0.1875,
      "ms_per_frame_attack": 25,
      "note": "PLACEHOLDER. Art plays faster; do not drop frames at 4× (8× OPEN may skip to keyframes)."
    },
    "strike_for_me_locks_1x": true
  },
  "weapon_families": {
    "sword": {
      "damage_kind": "physical",
      "items": [
        { "id": "stone_sword", "tier": 1, "sprite_id": "wpn_sword_t1", "display": "Flintblade", "bonuses": { "might": 2 } },
        { "id": "rootsteel_edge", "tier": 2, "sprite_id": "wpn_sword_t2", "display": "Rootsteel Edge", "bonuses": { "might": 5 } }
      ]
    },
    "wand": {
      "damage_kind": "magical",
      "items": [
        { "id": "weapon_rod", "tier": 0, "sprite_id": "wpn_wand_t0", "display": "Weapon Rod", "note": "refined intermediate; battle prop uses wand t0" },
        { "id": "sapstaff", "tier": 1, "sprite_id": "wpn_wand_t1", "display": "Sapstaff", "bonuses": { "arcana": 2 } },
        { "id": "heartwand", "tier": 2, "sprite_id": "wpn_wand_t2", "display": "Heartwand", "bonuses": { "arcana": 5 } }
      ]
    },
    "bow": {
      "damage_kind": "hybrid",
      "items": [
        { "id": "wpn_bow_t0", "tier": 0, "sprite_id": "wpn_bow_t0", "display": "(starter bow)", "note": "PLACEHOLDER tier art; no craft item yet" },
        { "id": "thornbow", "tier": 1, "sprite_id": "wpn_bow_t1", "display": "Thornbow", "bonuses": { "might": 1, "arcana": 1 } },
        { "id": "switchshaft", "tier": 2, "sprite_id": "wpn_bow_t2", "display": "Switchshaft", "bonuses": { "might": 3, "arcana": 3 } }
      ]
    }
  },
  "bare_hands_sprite_id": "wpn_none",
  "sheet_layout": {
    "cell_px": 128,
    "feet_row": 123,
    "center_x": 63.5,
    "party_facing": "east",
    "beast_facing": "west",
    "strip_axis": "horizontal",
    "path_pattern_party": "res://assets/art/battle/party/battle_{actor}_{anim}.png",
    "path_pattern_beast": "res://assets/art/battle/beasts/battle_{species}_{anim}.png",
    "path_pattern_weapon": "res://assets/art/battle/weapons/{sprite_id}.png",
    "weapon_attach": "overlay_on_attack_cast_frames"
  },
  "actors_party": {
    "keeper": { "anims": ["attack", "hit", "brace", "cast", "spare"], "live_stills": ["idle", "attack", "brace", "hurt", "ko"] },
    "elaia": { "anims": ["attack", "hit", "brace", "cast", "spare"], "live_stills": ["idle", "attack", "brace", "hurt", "ko"] },
    "puff": { "anims": ["attack", "hit", "brace", "cast", "spare"], "live_stills": [], "note": "not on main; R5 companion" },
    "moss_tortoise": { "anims": ["attack", "hit", "brace", "cast", "spare"], "live_stills": [], "note": "not on main; R5 Echo 4" },
    "bramble": { "anims": ["attack", "hit", "brace", "cast", "spare"], "live_stills": ["idle", "attack", "brace", "hurt", "ko"], "note": "live debug poses; included for parity" }
