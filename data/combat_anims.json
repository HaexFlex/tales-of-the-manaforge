    ],
    "variants_reuse_base": ["acorn_imp_dark", "spore_moth_dark"],
    "filler": {
      "foe_mossmite": { "anims": ["attack", "hit", "calm"], "live_poses": ["idle", "attack", "hurt"], "per_bug_1_to_10": true }
    },
    "anims_each": ["attack", "hit", "calm"],
    "calm_maps_to_playback": "calmed status / knocked_out calmed branch",
    "hit_maps_to_playback": "hurt pose",
    "art_missing_on_main": ["stump_ogre", "stag_spirit"]
  },
  "timings_1x": {
    "party": {
      "attack": { "frames": 8, "ms_per_frame": 100, "total_ms": 800, "hit_frame": 3, "hit_ms": 400, "maps_event": "strike" },
      "hit": { "frames": 4, "ms_per_frame": 100, "total_ms": 400, "hit_frame": 1, "hit_ms": 0, "maps_event": "react/hurt" },
      "brace": { "frames": 6, "ms_per_frame": 100, "total_ms": 600, "hit_frame": 2, "hit_ms": 200, "maps_event": "brace" },
      "cast": { "frames": 8, "ms_per_frame": 100, "total_ms": 800, "hit_frame": 5, "hit_ms": 500, "maps_event": "item/ability" },
      "spare": { "frames": 6, "ms_per_frame": 100, "total_ms": 600, "hit_frame": 3, "hit_ms": 300, "maps_event": "spare/calm outcome" }
    },
    "enemy": {
      "attack": { "frames": 8, "ms_per_frame": 100, "total_ms": 800, "hit_frame": 4, "hit_ms": 400, "maps_event": "strike" },
      "hit": { "frames": 4, "ms_per_frame": 100, "total_ms": 400, "hit_frame": 1, "hit_ms": 0, "maps_event": "react/hurt" },
      "calm": { "frames": 6, "ms_per_frame": 100, "total_ms": 600, "hit_frame": 3, "hit_ms": 300, "maps_event": "calmed" }
    },
    "alignment_note": "PLACEHOLDER. Party attack hit_frame 3 (4th frame, 0-indexed) @ 400ms == live REACT_SEC 0.4. Enemy attack hit_frame 4 PLACEHOLDER until per-species strips ship."
  },
  "playback_hooks": {
    "set_fighter_pose": "battle_view.gd:699",
    "pose_names_today": ["idle", "attack", "brace", "hurt", "ko"],
    "rename_or_alias": {
      "hit": "hurt",
      "calm": "calmed visual (beast alpha 0.35 today; strip replaces)"
    },
    "damage_pop": "BattlePlayback._on_target_react at local_t >= _scaled(REACT_SEC)",
    "weapon_swap": "when Equipment weapon changes, attack/cast strips composite body+wpn_<family>_t<tier>"
  }
}
