; Engine configuration file.
; Tales of the Manaforge — Restart Edition scaffold (Godot 4.7.2)

config_version=5

[application]

config/name="Tales of the Manaforge"
config/description="Cozy top-down pixel adventure. Restart Edition prototype: Keeper, Manatree, gather, prestige."
config/version="0.1.1-restart"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ContentStrings="*res://scripts/autoload/content_strings.gd"
GameAudio="*res://scripts/autoload/game_audio.gd"
GameState="*res://scripts/autoload/game_state.gd"
Backpack="*res://scripts/autoload/backpack.gd"
KeeperStats="*res://scripts/autoload/keeper_stats.gd"
Equipment="*res://scripts/autoload/equipment.gd"
SaveService="*res://scripts/autoload/save_service.gd"
EchoChamber="*res://scripts/autoload/echo_chamber.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="keeper"
2d_physics/layer_3="interactable"

[rendering]

textures/canvas_textures/default_texture_filter=0
